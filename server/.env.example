# Gateway
# No inline comments on a value line: Node's --env-file keeps them as part of
# the value, and so does systemd's EnvironmentFile.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=5252
# Optional second listener for local clients that want no TCP port at all.
# Linux/macOS: a filesystem path. Windows: \\.\pipe\gateway (named pipe).
GATEWAY_SOCKET=
GATEWAY_SOCKET_MODE=660
# Default directory for the database and the log. Relative paths (here and in
# GATEWAY_DB / GATEWAY_LOG) resolve against server/, never the process cwd, so
# `node dist/index.js` and `npm start` use the same files. Leave GATEWAY_DB and
# GATEWAY_LOG empty to place them inside GATEWAY_DATA_DIR.
GATEWAY_DATA_DIR=./data
GATEWAY_DB=./data/gateway.db
GATEWAY_LOG=./data/gateway.jsonl
GATEWAY_SYNC_INTERVAL_MS=300000
GATEWAY_BODY_LIMIT_BYTES=33554432
GATEWAY_LOG_PROMPTS=0

# Prompt hygiene: off | report | strip (default strip).
# strip removes invisible carriers (zero-width space, bidi controls, Unicode
# tags, BOM, soft hyphen, control bytes) while keeping a single ZWJ/ZWNJ between
# letters, marks or emoji. report counts without editing; off does not scan.
# An unknown value fails at boot on purpose.
GATEWAY_SANITIZE=strip

# Refuse a request that cannot fit the model's catalogue context length.
# Unknown length is reported as unknown and never enforced.
GATEWAY_CONTEXT_ENFORCE=1

# Minimum output reserve in tokens. A larger client max_tokens still wins.
# Empty = derive from the model window: clamp(limit/8, 256, 8192).
GATEWAY_OUTPUT_RESERVE=

# Behaviour layer: on | off | auto (default auto = on when the file exists).
# The text lives in policy.md and is injected once per request, never persisted.
# Unknown value fails at boot; client can opt out per call with "x-policy: off".
GATEWAY_POLICY=auto
GATEWAY_POLICY_FILE=

# Admin surface
# GATEWAY_ADMIN_AUTH is the only switch:
#   0 = admin API + metrics socket are open; a configured token is ignored
#   1 = token required for every /admin route and for the WebSocket handshake
#       (boot fails if GATEWAY_ADMIN_TOKEN is empty)
# unset = token required only when GATEWAY_ADMIN_TOKEN is set
GATEWAY_ADMIN_AUTH=0
GATEWAY_ADMIN_TOKEN=
# Empty = wildcard CORS (safe: bearer token, no cookies). Comma-separated list to
# pin origins; use the literal "null" for a page opened from file://.
GATEWAY_ADMIN_ORIGINS=

# Identity (SSI-Core). Headers are documented attribution, not a hidden watermark.
GATEWAY_IDENTITY_HEADERS=1
GATEWAY_IDENTITY_FILE=

# Provider grammar: CP_<ID>_<FIELD>
# ID is normalized to lowercase-with-dashes and becomes the public provider id.
# FIELD: BASE_URL | KIND | TRANSPORT | SOCKET | API_KEY | MODELS | CAPS | TIMEOUT_MS | HEADERS
# MODELS is a comma list of upstream ids the engine does not list itself
# (CP_CUSTOM_MODELS=gpt-4o-mini). It adds models; it never hides the ones the
# engine returns, and it is what makes an env-only deployment work when /models
# is missing or empty.

CP_OLLAMA_KIND=ollama
CP_OLLAMA_BASE_URL=http://127.0.0.1:11434
CP_OLLAMA_TRANSPORT=http
CP_OLLAMA_TIMEOUT_MS=600000

# Every group below is a commented example on purpose: a fresh clone must seed
# exactly the providers it can actually reach, not four dead placeholders that
# make /v1/providers look broken. Uncomment a group to add it.
#
# llama.cpp over TCP
# CP_LLAMACPP_KIND=llamacpp
# CP_LLAMACPP_BASE_URL=http://127.0.0.1:8080
# CP_LLAMACPP_TRANSPORT=http
# CP_LLAMACPP_CAPS=tools
# CP_LLAMACPP_TIMEOUT_MS=600000
#
# llama.cpp over a Unix socket (llama-server --host /run/llama/llama.sock)
# CP_LLAMACPP_UDS_KIND=llamacpp
# CP_LLAMACPP_UDS_BASE_URL=http://localhost
# CP_LLAMACPP_UDS_TRANSPORT=uds
# CP_LLAMACPP_UDS_SOCKET=/run/llama/llama.sock
#
# Any OpenAI-compatible cloud API
# CP_CUSTOM_KIND=openai
# CP_CUSTOM_BASE_URL=https://api.example.com/v1
# CP_CUSTOM_API_KEY=
# CP_CUSTOM_MODELS=
# CP_CUSTOM_CAPS=tools
#
# OpenCode's own server (kind=opencode)
# CP_OPENCODE_KIND=opencode
# CP_OPENCODE_BASE_URL=http://127.0.0.1:4096
# CP_OPENCODE_TIMEOUT_MS=600000
