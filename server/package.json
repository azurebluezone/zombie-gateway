{
  "name": "compatible-providers-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prestart": "node scripts/setup.mjs --quiet",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "prestart:dist": "node scripts/setup.mjs --quiet",
    "start:dist": "node --env-file-if-exists=.env dist/index.js",
    "probe": "node --env-file-if-exists=.env src/tools/probe.ts",
    "mcp": "node --env-file-if-exists=.env scripts/gateway-mcp.mjs",
    "live": "node --env-file-if-exists=.env tools/live-check.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
